<?xml version="1.0" encoding="utf-8"?>
<!-- BEISPIELLAYOUT -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/ll_template" >

    <!-- Erstes Gebäude -->
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10px"
        android:baselineAligned="false">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="0.35"
            >

            <!-- Einwohner -->
            <TextView
                android:id="@+id/tv_gbLayout_gb_ew"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10px"
                android:paddingBottom="10px"
                android:paddingRight="20px"
                android:paddingLeft="20px"
                android:layout_weight="1"
                android:gravity="right"
                android:background="#ffdedad9"
                android:layout_marginLeft="20px"
                android:layout_marginRight="20px"
                android:layout_marginTop="20px"
                android:layout_marginBottom="5px" />

            <!-- Felder -->
            <TextView
                android:id="@+id/tv_gbLayout_gb_flds"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10px"
                android:paddingBottom="10px"
                android:paddingRight="20px"
                android:paddingLeft="20px"
                android:layout_weight="1"
                android:gravity="right"
                android:layout_marginLeft="20px"
                android:layout_marginTop="5px"
                android:layout_marginRight="20px"
                android:layout_marginBottom="5px" />

            <!-- Unterhalt -->
            <TextView
                android:id="@+id/tv_gbLayout_gb_unt"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/cost"
                android:layout_weight="1"
                android:gravity="right"
                android:background="#ffdedad9"
                android:layout_marginLeft="20px"
                android:layout_marginRight="20px"
                android:layout_marginTop="5px"
                android:layout_marginBottom="5px"
                android:paddingTop="10px"
                android:paddingBottom="10px"
                android:paddingRight="20px"
                android:paddingLeft="20px"
                />

            <!-- Radius -->
            <TextView
                android:id="@+id/tv_gbLayout_gb_rds"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10px"
                android:paddingBottom="10px"
                android:paddingRight="20px"
                android:paddingLeft="20px"
                android:layout_weight="1"
                android:drawableLeft="@drawable/radius"
                android:gravity="right"
                android:background="#ffdedad9"
                android:layout_marginLeft="20px"
                android:layout_marginRight="20px"
                android:layout_marginTop="5px"
                android:layout_marginBottom="5px" />

            <!-- Platzbedarf -->
            <TextView
                android:id="@+id/tv_gbLayout_gb_grsse"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/groesse"
                android:paddingTop="10px"
                android:paddingBottom="10px"
                android:paddingRight="20px"
                android:paddingLeft="20px"
                android:layout_weight="1"
                android:gravity="right"
                android:background="#ffdedad9"
                android:layout_marginLeft="20px"
                android:layout_marginTop="5px"
                android:layout_marginRight="20px"
                android:layout_marginBottom="20px" />

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:paddingBottom="20px"
            >

            <!-- Image -->
            <ImageView
                android:id="@+id/iv_gbLayout_gb_img"
                android:src="@drawable/anno_online_logo"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="15px"
                />

            <!-- Gebäudebezeichnung -->
            <TextView
                android:id="@+id/tv_gbLayout_gb_bez"
                android:text="@string/str_dummy"
                android:layout_width="fill_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                />

            <!-- Anzahl -->
            <TextView
                android:id="@+id/tv_gbLayout_gb_anzahl"
                android:text="@string/str_dummy"
                android:layout_width="fill_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                />

            <!-- Bild der Ware -->
            <TextView
                android:id="@+id/tv_gbLayout_gb_produkt"
                android:text="@string/str_dummy"
                android:drawableTop="@drawable/zimmermann"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                />

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="0.35"
            >

            <!-- Gold -->
            <TextView
                android:id="@+id/tv_gbLayout_gb_gold"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10px"
                android:paddingBottom="10px"
                android:paddingRight="20px"
                android:paddingLeft="20px"
                android:layout_weight="1"
                android:layout_marginLeft="20px"
                android:layout_marginRight="20px"
                android:layout_marginTop="20px"
                android:layout_marginBottom="5px"
                android:gravity="right" />

            <!-- Holz -->
            <TextView
                android:id="@+id/tv_gbLayout_gb_holz"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10px"
                android:paddingBottom="10px"
                android:paddingRight="20px"
                android:paddingLeft="20px"
                android:layout_weight="1"
                android:gravity="right"
                android:layout_marginLeft="20px"
                android:layout_marginTop="5px"
                android:layout_marginRight="20px"
                android:layout_marginBottom="5px"
                />

            <!-- Stein -->
            <TextView
                android:id="@+id/tv_gbLayout_gb_stein"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10px"
                android:paddingBottom="10px"
                android:paddingRight="20px"
                android:paddingLeft="20px"
                android:layout_weight="1"
                android:gravity="right"
                android:layout_marginLeft="20px"
                android:layout_marginTop="5px"
                android:layout_marginRight="20px"
                android:layout_marginBottom="5px"
                />

            <!-- Werkzeuge -->
            <TextView
                android:id="@+id/tv_gbLayout_gb_wkz"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10px"
                android:paddingBottom="10px"
                android:paddingRight="20px"
                android:paddingLeft="20px"
                android:layout_weight="1"
                android:gravity="right"
                android:layout_marginLeft="20px"
                android:layout_marginTop="5px"
                android:layout_marginRight="20px"
                android:layout_marginBottom="5px"
                />

            <!-- Glas -->
            <TextView
                android:id="@+id/tv_gbLayout_gb_glas"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10px"
                android:paddingBottom="10px"
                android:paddingRight="20px"
                android:paddingLeft="20px"
                android:layout_weight="1"
                android:gravity="right"
                android:layout_marginLeft="20px"
                android:layout_marginTop="5px"
                android:layout_marginRight="20px"
                android:layout_marginBottom="20px"
                />

        </LinearLayout>

    </LinearLayout>

    <!-- Trennbanlken -->
    <View
        android:layout_marginTop="10px"
        android:layout_marginRight="20px"
        android:layout_marginLeft="20px"
        android:layout_marginBottom="10px"
        android:layout_width="wrap_content"
        android:layout_height="2px"
        android:background="@android:color/darker_gray"/>

    <!-- Button -->
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="fill_parent"
        android:baselineAligned="false">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            >

            <!-- Button -->
            <Button
                android:id="@+id/btn_gbLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="OK"
                />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>