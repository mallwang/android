<?xml version="1.0" encoding="utf-8"?>
<!-- INSELN -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">
        <TableLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <!-- INSELN -->
            <TableRow
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <!-- INSELN -->
                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/insel"
                        android:drawableRight="@drawable/insel"
                        android:text="@string/str_kat_inseln"
                        android:padding="20px"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:gravity="center"/>
                    <!-- Trennlinie -->
                    <View
                        android:layout_marginRight="5dp"
                        android:layout_marginLeft="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@android:color/darker_gray"/>
                    <!-- Inseln 1 -->
                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="10px"
                        android:layout_marginTop="5px"
                        android:layout_weight="1"
                        android:baselineAligned="false">
                        <RelativeLayout
                            android:layout_width="0dp"
                            android:padding="10px"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5">
                            <ImageButton
                                android:id="@+id/btn_insel_klein"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/insel_klein_gross"
                                android:layout_alignParentTop="true"
                                android:layout_centerHorizontal="true"
                                android:background="@android:color/transparent"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:layout_width="0dp"
                            android:padding="10px"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5">
                            <ImageButton
                                android:id="@+id/btn_inseln_mittel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/insel_mittel_gross"
                                android:layout_alignParentTop="true"
                                android:layout_centerHorizontal="true"
                                android:background="@android:color/transparent"/>
                        </RelativeLayout>
                    </LinearLayout>
                    <!-- Inseln 2 -->
                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="10px"
                        android:layout_marginTop="5px"
                        android:layout_weight="1"
                        android:baselineAligned="false">
                        <RelativeLayout
                            android:layout_width="0dp"
                            android:padding="10px"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.25">
                            <ImageButton
                                android:id="@+id/btn_inseln_gross"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/insel_gross_gross"
                                android:layout_alignParentTop="true"
                                android:layout_centerHorizontal="true"
                                android:background="@android:color/transparent"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:layout_width="0dp"
                            android:padding="10px"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.25">
                            <ImageButton
                                android:id="@+id/btn_inseln_riesig"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/insel_riesig_gross"
                                android:layout_alignParentTop="true"
                                android:layout_centerHorizontal="true"
                                android:background="@android:color/transparent"/>
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
            </TableRow>
        </TableLayout>
    </RelativeLayout>
</ScrollView>