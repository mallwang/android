<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent" >

    <TableRow
        android:id="@+id/tableRow1"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:padding="5dip" >

        <TextView
            android:id="@+id/ortsname"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:maxWidth="@dimen/activity_horizontal_margin"
            android:text="Stadtname"
            tools:ignore="HardcodedText" />
    </TableRow>

    <TableRow
        android:id="@+id/tableRow2"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:padding="5dip" >

        <Button
            android:id="@+id/btnSehensw"
            android:layout_weight=".3"
            android:layout_height="match_parent"
            android:onClick="showAllSehensweurdigkeiten"
            android:text="@string/sehenswuerdigkeiten" />

        <TextView
            android:id="@+id/tvSehensw"
            android:layout_height="match_parent"
            android:layout_weight=".7"
            android:text="Alle Sehenswürdigkeiten von Ensdorf und Umgebung" />

    </TableRow>

    <TableRow
        android:id="@+id/tableRow3"
        android:layout_weight="1"
        android:layout_height="fill_parent"
        android:padding="5dip" >

        <Button
            android:id="@+id/btnParks"
            android:layout_weight=".3"
            android:layout_height="match_parent"
            android:onClick="showAllParks"
            android:text="@string/parks" />

        <TextView
            android:id="@+id/tvParks"
            android:layout_weight=".7"
            android:layout_height="match_parent"
            android:text="Alle Parks von Ensdorf und Umgebung" />
    </TableRow>

    <TableRow
        android:id="@+id/tableRow4"
        android:layout_weight="1"
        android:layout_height="fill_parent"
        android:padding="5dip" >

        <Button
            android:id="@+id/btnMuseen"
            android:layout_weight=".3"
            android:layout_height="match_parent"
            android:onClick="showAllMuseen"
            android:text="@string/museen" />

        <TextView
            android:id="@+id/tvMuseen"
            android:layout_weight=".7"
            android:layout_height="match_parent"
            android:text="Alle Museen von Ensdorf und Umgebung" />
    </TableRow>

</TableLayout>