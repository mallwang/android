{
  "name": "woistwas-capacitor",
  "version": "1.9.0",
  "author": "Markus Allwang (markus.allwang@tuta.io)",
  "description": "The Wo ist was?! application",
  "homepage": "https://iusemybrain.de",
  "scripts": {
    "build:dev": "ionic build",
    "build:prod": "ionic build --prod",
    "explore-source-map": "ionic build --prod --source-map&&source-map-explorer www/main*.js",
    "lint": "eslint {e2e,src}/**/*.ts",
    "lint:fix": "eslint {e2e,src}/**/*.ts --fix",
    "ng": "ng",
    "prettier:check": "prettier --check **/*.{json,js,ts,yml,yaml,md,html,scss}",
    "prettier:format": "prettier --write **/*.{json,js,ts,yml,yaml,md,html,scss}",
    "start": "ng serve -o",
    "test": "ng test",
    "test:e2e": "ng e2e --no-webdriver-update",
    "test:local": "ng test --watch=true --progress=true --codeCoverage=true"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~10.0.0",
    "@angular/core": "~10.0.0",
    "@angular/forms": "~10.0.0",
    "@angular/platform-browser": "~10.0.0",
    "@angular/platform-browser-dynamic": "~10.0.0",
    "@angular/router": "~10.0.0",
    "@capacitor/android": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/geolocation": "^5.0.0",
    "@ionic-native/core": "^5.0.0",
    "@ionic-native/splash-screen": "^5.0.0",
    "@ionic-native/status-bar": "^5.0.0",
    "@ionic/angular": "^5.0.0",
    "rxjs": "~6.5.5",
    "tslib": "^2.0.0",
    "zone.js": "~0.10.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^0.1002.0",
    "@angular/cli": "~10.0.5",
    "@angular/compiler": "~10.0.0",
    "@angular/compiler-cli": "~10.0.0",
    "@angular/language-service": "~10.0.0",
    "@capacitor/cli": "^5.0.0",
    "@commitlint/cli": "^11.0.0",
    "@commitlint/config-conventional": "^11.0.0",
    "@ionic/angular-toolkit": "^2.3.0",
    "@types/jasmine": "~3.5.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^12.11.1",
    "@typescript-eslint/eslint-plugin": "^4.5.0",
    "@typescript-eslint/parser": "^4.5.0",
    "codelyzer": "^6.0.0",
    "eslint": "^7.12.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^6.14.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-prettier": "^3.1.4",
    "husky": "^4.3.0",
    "jasmine-core": "~3.5.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~5.0.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~3.3.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "prettier": "^2.1.2",
    "pretty-quick": "^3.1.0",
    "protractor": "~7.0.0",
    "source-map-explorer": "^2.5.0",
    "ts-node": "~8.3.0",
    "typescript": "~3.9.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged",
      "pre-push": "npm run lint",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "engineStrict": true,
  "engines": {
    "node": ">= 16",
    "npm": ">= 8"
  }
}
